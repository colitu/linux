  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "process_path": "/usr/bin/firefox",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geoip-ru",
          "geosite-category-ru"
        ],
        "outbound": "direct"
