{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "detour": "proxy",
        "server": "192.0.2.53",
        "path": "/dns-query"
      },
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-category-ru",
        "server": "local"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singbox_tun",
      "mtu": 9000,
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "gvisor"
    },
    {
      "type": "mixed",
      "tag": "socks",
      "listen": "127.0.0.1",
      "listen_port": 10808
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "192.0.2.10",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "tls": {
        "enabled": true,
        "server_name": "node.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "type": "ws",
        "path": "/ws?ed=2048",
        "headers": {
          "Host": "node.example.com"
        }
      }
    },
    {
      "type": "http",
      "tag": "http-out",
      "server": "192.0.2.11",
